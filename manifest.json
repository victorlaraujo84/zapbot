{
  "manifest_version": 3,
  "name": "ZapBot Pro - Automação WhatsApp Web & IA",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "description": "Disparador em massa, extrator de contatos e auto-resposta inteligente com IA para WhatsApp Web.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "Abrir ZapBot Pro",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "modules/storage-manager.js",
        "modules/mention-detector.js",
        "modules/conversation-store.js",
        "modules/followup-engine.js",
        "modules/text-utils.js",
        "modules/dedup-log.js",
        "content/whatsapp-driver.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
